oa:Electronics a owl:Class ;
    rdfs:label "Electronics" ;
    rdfs:subClassOf oa:Product .

oa:CompetitionState a owl:Class ;
    rdfs:label "Competition state" ;
    rdfs:subClassOf oa:AuctionState .

oa:DurationState a owl:Class ;
    rdfs:label "Duration state" ;
    rdfs:subClassOf oa:AuctionState .

oa:Product a owl:Class ;
    rdfs:label "Product" .

oa:UpliftState a owl:Class ;
    rdfs:label "Price uplift state" ;
    rdfs:subClassOf oa:AuctionState .

oa:MomentumState a owl:Class ;
    rdfs:label "Momentum state" ;
    rdfs:subClassOf oa:AuctionState .

oa:ReputationState a owl:Class ;
    rdfs:label "Reputation state" ;
    rdfs:subClassOf oa:AuctionState .

oa:AuctionState a owl:Class ;
    rdfs:label "Auction state" .

oa:ModerateUplift a owl:Class ;
    rdfs:comment "Standing price from 1.10 to below 1.75 times the opening price (on the log1p scale)." ;
    rdfs:subClassOf oa:UpliftState .

oa:product_CartierWristwatch a oa:CartierWristwatch,
        owl:NamedIndividual .

oa:product_XboxGameConsole a oa:XboxGameConsole,
        owl:NamedIndividual .

oa:HighReputation a owl:Class ;
    rdfs:comment "Mean feedback above 100." ;
    rdfs:subClassOf oa:ReputationState .

oa:ActivatedAuction a owl:Class ;
    rdfs:comment "No bid in the first half of the observed window, at least one in the second half." ;
    rdfs:subClassOf oa:MomentumState .

oa:MediumAuction a owl:Class ;
    rdfs:comment "Scheduled duration of 5 days." ;
    rdfs:subClassOf oa:DurationState .

oa:AcceleratingAuction a owl:Class ;
    rdfs:comment "More bids in the second half of the observed window than in the first half." ;
    rdfs:subClassOf oa:MomentumState .

oa:product_PalmPilotM515 a oa:PalmPilotM515,
        owl:NamedIndividual .

oa:EmergingReputation a owl:Class ;
    rdfs:comment "Mean feedback in (0, 10]." ;
    rdfs:subClassOf oa:ReputationState .

oa:ShortAuction a owl:Class ;
    rdfs:comment "Scheduled duration of 3 days." ;
    rdfs:subClassOf oa:DurationState .

oa:ModerateCompetition a owl:Class ;
    rdfs:comment "Two or three distinct bidders." ;
    rdfs:subClassOf oa:CompetitionState .

oa:DormantAuction a owl:Class ;
    rdfs:comment "No bid by the snapshot." ;
    rdfs:subClassOf oa:MomentumState .

oa:UnratedBidders a owl:Class ;
    rdfs:comment "No bidder yet, or mean feedback at most 0." ;
    rdfs:subClassOf oa:ReputationState .

oa:Auction a owl:Class ;
    rdfs:label "Auction" .

oa:HighCompetition a owl:Class ;
    rdfs:comment "Four or more distinct bidders." ;
    rdfs:subClassOf oa:CompetitionState .

oa:EstablishedReputation a owl:Class ;
    rdfs:comment "Mean feedback in (10, 100]." ;
    rdfs:subClassOf oa:ReputationState .

oa:LowCompetition a owl:Class ;
    rdfs:comment "At most one distinct bidder." ;
    rdfs:subClassOf oa:CompetitionState .

oa:LowUplift a owl:Class ;
    rdfs:comment "Standing price below 1.10 times the opening price (on the log1p scale)." ;
    rdfs:subClassOf oa:UpliftState .

oa:SteadyAuction a owl:Class ;
    rdfs:comment "Bids in the first half and no more bids in the second half than in the first half." ;
    rdfs:subClassOf oa:MomentumState .

oa:HighUplift a owl:Class ;
    rdfs:comment "Standing price at least 1.75 times the opening price (on the log1p scale)." ;
    rdfs:subClassOf oa:UpliftState .

oa:LongAuction a owl:Class ;
    rdfs:comment "Scheduled duration of 7 days." ;
    rdfs:subClassOf oa:DurationState .

oa:PricePrediction a owl:Class ;
    rdfs:label "Price prediction" .

oa:Snapshot a owl:Class ;
    rdfs:label "Snapshot" ;
    rdfs:comment "An auction observed at a fixed fraction of its scheduled duration." .

