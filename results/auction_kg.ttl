oa:bidCount a owl:DatatypeProperty ;
    rdfs:domain oa:Snapshot ;
    rdfs:range xsd:integer .

oa:bidderCount a owl:DatatypeProperty ;
    rdfs:domain oa:Snapshot ;
    rdfs:range xsd:integer .

oa:finalPrice a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    oa:isPredictionTarget true ;
    oa:observableAtFraction 1.0 ;
    rdfs:domain oa:Auction ;
    rdfs:range xsd:decimal .

oa:hasPrediction a owl:ObjectProperty ;
    rdfs:domain oa:Snapshot ;
    rdfs:range oa:PricePrediction .

oa:hasProduct a owl:ObjectProperty ;
    rdfs:domain oa:Auction ;
    rdfs:range oa:Product .

oa:hasSnapshot a owl:ObjectProperty ;
    rdfs:domain oa:Auction ;
    rdfs:range oa:Snapshot .

oa:isPredictionTarget a owl:AnnotationProperty ;
    rdfs:label "is prediction target" .

oa:meanBidderFeedback a owl:DatatypeProperty ;
    rdfs:domain oa:Snapshot ;
    rdfs:range xsd:decimal .

oa:modelName a owl:DatatypeProperty ;
    rdfs:domain oa:PricePrediction ;
    rdfs:range xsd:string .

oa:observableAtFraction a owl:AnnotationProperty ;
    rdfs:label "observable at fraction" ;
    rdfs:comment "Earliest fraction of the scheduled auction duration at which the value of a datatype property is public information." .

oa:observationFraction a owl:DatatypeProperty ;
    rdfs:domain oa:Snapshot ;
    rdfs:range xsd:decimal .

oa:openingPrice a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    oa:observableAtFraction 0.0 ;
